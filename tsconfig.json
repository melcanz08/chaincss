{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx", 
    "rootDir": "./src",
    "paths": {
      "@core/*": ["./src/core/*"],
      "@compiler/*": ["./src/compiler/*"],
      "@adapters/*": ["./src/adapters/*"],
      "@shared/*": ["./src/shared/*"],
      "@frameworks/*": ["./src/frameworks/*"]
    },
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "__tests__"
  ]
}
