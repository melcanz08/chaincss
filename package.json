{
  "name": "chaincss",
  "version": "2.15.14",
  "description": "The design-system compiler with compile-time accessibility and multi-target emission.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./dist/browser.js",
      "import": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "require": "./dist/index.cjs"
      }
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/core-entry.js",
      "require": "./dist/core-entry.cjs"
    },
    "./runtime": {
      "types": "./dist/runtime-entry.d.ts",
      "import": "./dist/runtime/index.js",
      "require": "./dist/runtime/index.cjs"
    },
    "./compiler": {
      "types": "./dist/compiler-entry.d.ts",
      "import": "./dist/compiler/index.js",
      "require": "./dist/compiler/index.cjs"
    },
    "./utils": {
      "types": "./dist/utils-entry.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js",
      "require": "./dist/advanced.js"
    },
    "./vite": {
      "types": "./dist/frameworks/build-tools/vite/index.d.ts",
      "import": "./dist/plugins/vite.js",
      "require": "./dist/plugins/vite.cjs"
    },
    "./webpack": {
      "types": "./dist/frameworks/build-tools/webpack/index.d.ts",
      "import": "./dist/plugins/webpack.js",
      "require": "./dist/plugins/webpack.cjs"
    },
    "./figma-sync": {
      "types": "./dist/frameworks/build-tools/figma-sync/index.d.ts",
      "import": "./dist/plugins/figma-sync.js",
      "require": "./dist/plugins/figma-sync.cjs"
    },
    "./entanglement": {
      "types": "./dist/compiler/tokens/entanglement.d.ts",
      "import": "./dist/compiler/tokens/entanglement.js",
      "require": "./dist/compiler/tokens/entanglement.cjs"
    },
    "./next/server": {
      "types": "./dist/frameworks/next/server.d.ts",
      "import": "./dist/next/server.js",
      "require": "./dist/next/server.cjs"
    },
    "./next/client": {
      "types": "./dist/frameworks/next/client.d.ts",
      "import": "./dist/next/client.js",
      "require": "./dist/next/client.cjs"
    },
    "./next": {
      "types": "./dist/frameworks/next/plugin.d.ts",
      "import": "./dist/next/plugin.js",
      "require": "./dist/next/plugin.cjs"
    },
    "./postcss": {
      "import": "./dist/postcss/index.js",
      "require": "./dist/postcss/index.cjs"
    },
    "./token-api": {
      "types": "./dist/token-api.d.ts",
      "import": "./dist/token-api.js",
      "require": "./dist/token-api.cjs"
    }
  },
  "scripts": {
    "audit": "chaincss audit --fail-on AA",
    "audit:fix": "chaincss audit --fix --write",
    "audit:report": "chaincss audit --fix --json ./reports/a11y.json",
    "audit:contrast": "node ./dist/cli/index.js audit --fail-on AA --json ./reports/a11y.json",
    "audit:contrast:strict": "chaincss audit --fail-on AAA --strict",
    "build": "npm run build:clean && node scripts/build.mjs && npm run build:types",
    "build_test": "rm -rf dist .chaincss-cache && npm run build:clean && node scripts/build.mjs && npm run build:types && vitest run",
    "build:watch": "npm run build:clean && npm run build:types && node scripts/build.mjs --watch",
    "build:clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json && cp dist/index.d.ts dist/index.d.cts",
    "build:core": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external --external:vue --external:react --external:react-dom --external:svelte",
    "build:cli": "esbuild src/adapters/cli/index.ts --bundle --platform=node --format=esm --outfile=dist/cli/index.js --packages=external && printf '#!/usr/bin/env node\\n' | cat - dist/cli/index.js > dist/cli/tmp && mv dist/cli/tmp dist/cli/index.js && chmod +x dist/cli/index.js",
    "build:plugins": "esbuild src/frameworks/build-tools/vite/index.ts --bundle --platform=node --format=esm --outfile=dist/plugins/vite.js --packages=external && esbuild src/frameworks/build-tools/figma-sync/index.ts --bundle --platform=node --format=esm --outfile=dist/plugins/figma-sync.js --packages=external && esbuild src/frameworks/build-tools/webpack/index.ts --bundle --platform=node --format=esm --outfile=dist/plugins/webpack.js --packages=external",
    "build:runtime": "esbuild src/runtime/index.ts --bundle --platform=browser --format=esm --outfile=dist/runtime/index.js --external:react --external:react-dom --external:vue --external:svelte --external:url",
    "build:browser": "esbuild src/browser.ts --bundle --platform=browser --format=esm --outfile=dist/browser.js --external:react --external:react-dom --external:vue --external:svelte --external:url",
    "build:compiler": "esbuild src/compiler/index.ts --bundle --platform=node --format=esm --outfile=dist/compiler/index.js --packages=external",
    "dev": "tsc -w",
    "verify": "node verify-full.mjs",
    "verify:full": "npm run build && npm run verify && npm test",
    "prepublishOnly": "npm run build:clean && node scripts/build.mjs && npm run build:types && node verify-full.mjs && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:verbose": "CHAINCSS_TEST_VERBOSE=1 vitest run",
    "test:unit": "vitest run __tests__/unit",
    "test:integration": "vitest run __tests__/integration",
    "bench:baseline": "node --expose-gc --import tsx benchmarks/save-baseline.js",
    "bench:check": "node --expose-gc --import tsx benchmarks/check-regression.js",
    "bench:ci": "npm run bench:check",
    "tokens:watch": "chaincss entanglement --input figma-tokens.json --watch --figma",
    "tokens:fix": "chaincss entanglement --fix",
    "migrate:analyze": "node scripts/migrate-to-new-architecture.mjs",
    "analyze:deps": "npx madge --circular --extensions ts,tsx src/",
    "arch:check": "npm run analyze:deps && npm run migrate:analyze"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "svelte": ">=4.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^1.6.0",
    "csstype": "^3.2.3",
    "esbuild": "^0.25.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "semver": "^7.8.5",
    "tsx": "^4.22.4",
    "typescript": "^7.0.2",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "vitest": {
    "setupFiles": [
      "./vitest.setup.ts"
    ]
  },
  "keywords": [
    "css-in-js",
    "zero-runtime",
    "atomic-css",
    "mixed-mode",
    "auto-detection",
    "react",
    "vue",
    "svelte",
    "vite",
    "webpack"
  ],
  "author": "Rommel Caneos",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melcanz08/chaincss.git"
  },
  "homepage": "https://chaincss.dev",
  "bugs": {
    "url": "https://github.com/melcanz08/chaincss/issues"
  },
  "sideEffects": [
    "*.css",
    "./dist/runtime/**/*.js",
    "./dist/runtime/**/*.cjs",
    "./dist/browser.js",
    "./dist/next/client.js",
    "./dist/next/client.cjs",
    "./dist/plugins/vite.js",
    "./dist/plugins/vite.cjs",
    "./dist/plugins/webpack.js",
    "./dist/plugins/figma-sync.js",
    "./dist/cli/index.js"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "browserslist": "^4.28.2",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "glob": "^13.0.6",
    "jiti": "^2.7.0"
  },
  "browser": "./dist/browser.js",
  "bin": {
    "chaincss": "./dist/cli/index.js"
  },
  "files": [
    "dist"
  ]
}