{
  "name": "chaincss-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "run": "node --expose-gc run.js",
    "quick": "node --expose-gc run.js --quick",
    "ci": "node --expose-gc run.js --ci --output results/",
    "bench:incremental": "node benchmark-stateful-incremental.js",
    "bench:incremental:small": "node benchmark-stateful-incremental.js --small",
    "bench:incremental:large": "node benchmark-stateful-incremental.js --large",
    "bench:incremental": "node --import tsx benchmarks/benchmark-stateful-incremental.js"
  },
  "dependencies": {
    "@stylexjs/stylex": "^0.10.0",
    "@vanilla-extract/css": "^1.15.0",
    "benny": "^3.7.0",
    "gzip-size": "^7.0.0"
  }
}