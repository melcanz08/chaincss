cd /home/melcanz/dev/chaincss

# Remove duplicate entries and add missing ones
cat > .gitignore << 'EOF'
node_modules/
*.log
.DS_Store
.env
*.tgz
npm-debug.log*
.npmrc

# Build output
dist/

# ChainCSS generated files
*.class.js
*.class.ts

# Cache
.chaincss-cache
.chaincss-cache/
.chaincss/

# Backup files
*.bak
*.bck

# Benchmark results (keep baseline)
benchmarks/results/*
!benchmarks/results/baseline.json
benchmarks/node_modules/
benchmarks/package-lock.json

# Tests
__tests__/

# Docs / Temp
demo/
demo-website/
review.md
EOF